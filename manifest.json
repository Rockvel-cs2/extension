{
  "manifest_version": 3,
  "name": "Rockvel",
  "version": "0.5.0",
  "description": "Reads your CS2 inventory for Rockvel, sends the trade offers for your sales and follows them on Steam.",
  "key": "",
  "icons": { "128": "icon.png" },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["alarms", "declarativeNetRequestWithHostAccess", "notifications", "storage"],
  "host_permissions": [
    "https://steamcommunity.com/*",
    "https://api.steampowered.com/*",
    "https://rockvel.store/*",
    "http://localhost:4000/*"
  ],
  "declarative_net_request": {
    "rule_resources": [{ "id": "steam_referer", "enabled": true, "path": "rules.json" }]
  },
  "externally_connectable": {
    "matches": ["https://rockvel.store/*", "http://localhost:4000/*"]
  }
}
